import hashlib
import requests
import string

def check_leaked_password(password):
    # Hash password
    sha1_hash = hashlib.sha1(password.encode('utf-8')).hexdigest().upper()
    prefix, suffix = sha1_hash[:5], sha1_hash[5:]

    # Query HIBP API
    url = f"https://api.pwnedpasswords.com/range/{prefix}"
    response = requests.get(url)
    if response.status_code != 200:
        raise RuntimeError("Error fetching data from HIBP API")

    # Check if suffix is in response
    hashes = (line.split(':') for line in response.text.splitlines())
    for h, count in hashes:
        if h == suffix:
            return f"Very Weak (leaked {count} times)"
    return None

def check_password_strength(password):
    leak_status = check_leaked_password(password)
    if leak_status:
        return leak_status

    if len(password) < 8:
        return "Weak (too short)"

    has_upper = any(char.isupper() for char in password)
    has_digit = any(char.isdigit() for char in password)
    has_symbol = any(char in string.punctuation for char in password)

    if has_upper and has_digit and has_symbol:
        return "Strong"
    elif has_upper or has_digit or has_symbol:
        return "Medium"
    else:
        return "Weak"

# Examples:
print(check_password_strength("password"))         # Very Weak (leaked many times)
print(check_password_strength("u949"))             # Weak (too short)
print(check_password_strength("Passworte91"))      # Medium
print(check_password_strength("P@55w0rd123321"))   # Strong
print(check_password_strength("uniquePhrase!9"))   # Strong
